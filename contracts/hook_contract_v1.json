      "hook.history_verified",
      "hook.history_read",
      "hook.voice_transcription",
      "hook.send_delay",
      "hook.send_call",
      "hook.send_reconcile"
    ],
    "clock": "execution durations use one process monotonic clock; no synthetic end-to-end sum",
    "authority": "backend issued process id; observation never grants execution"
  }
