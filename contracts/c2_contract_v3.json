  },
  "image_transaction_recovery_contract": {
    "authorization_endpoint": "GET /api/workers/{worker_id}/wechat/conversations/{conversation_id}/read-authorization",
    "decisions": ["allowed", "retry_later", "target_terminated"],
    "decision_field": "recovery_decision",
    "allowed_target_field": "target",
    "not_attempted_rule": "an image action journal whose every item is explicitly not_attempted may be removed locally before the global transaction barrier only when it is a pure action intent with no terminal payload, no completed or failed ledger fact, and no corresponding outbox record; any formed completed or failed fact must enter settlement regardless of action_phase",
    "retry_later_rule": "retain the exact ledger and action journal, block new UI actions, and retry the lightweight authorization check without reopening another conversation",
    "target_terminated_rule": "only a backend-confirmed permanent target termination may mark the exact conversation's waiting image facts not_required and remove its image action journals",
    "unknown_decision_rule": "missing or unknown decisions fail closed as retry_later"
  },
  "outbox_recovery_contract": {
    "actions": [
      "retry",
      "refresh_identity_and_retry",
      "refresh_and_rebuild",
      "rebuild_failed_facts",
      "split_and_retry",
      "capability_paused",
      "target_terminated",
      "conversation_terminated"
    ],
    "response_field": "data.recovery_action",
    "refresh_identity_and_retry_codes": [
      "MESSAGE_IDENTITY_COLLISION"
    ],
    "refresh_and_rebuild_codes": [
      "MESSAGE_AUTHORIZATION_REVISION_EXPIRED"
    ],
    "rebuild_failed_fact_codes": [
