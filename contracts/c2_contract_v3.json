{
  "contract_version": 3,
  "contract_revision": "3.8.0",
  "observation_schema_version": 3,
  "control_schema_version": 1,
  "sender_roles": ["customer", "self", "system", "unknown"],
  "message_types": ["text", "image", "voice", "system", "file", "unknown"],
  "row_kinds": [
    "text_bubble",
    "voice_bubble",
    "voice_transcript",
    "image_bubble",
    "system_message",
    "call_event",
    "system_banner",
    "unknown"
  ],
  "ingestible_row_kinds": [
    "text_bubble",
    "voice_transcript",
    "image_bubble",
    "system_message"
  ],
  "chat_message_row_kinds": ["text_bubble", "voice_transcript", "image_bubble"],
  "voice_states": ["not_voice", "untranscribed", "transcribed"],
  "action_phases": ["not_attempted", "trigger_attempted", "confirmed"],
  "action_result_contract": {
    "send": {
      "not_attempted": "failed",
      "trigger_attempted": "unknown",
      "confirmed": "sent"
    },
    "voice": {
      "not_attempted": "failed",
      "trigger_attempted": "failed",
      "confirmed": "completed"
    },
    "image": {
      "not_attempted": "failed",
      "trigger_attempted": "failed",
      "confirmed": "completed"
    },
    "unknown_error_codes": {
      "send": "SEND_RESULT_UNKNOWN",
      "voice": "VOICE_TRANSCRIBE_RESULT_UNKNOWN",
      "image": "IMAGE_COPY_RESULT_UNKNOWN"
    },
    "missing_phase_fallback": "trigger_attempted",
    "business_completion": {
      "send": {
        "completed_states": ["sent"],
        "unconfirmed_result": "unknown",
        "unconfirmed_error_code": "SEND_RESULT_UNKNOWN"
      },
      "voice": {
        "completed_states": ["completed"],
        "unconfirmed_result": "failed",
        "unconfirmed_error_code": "VOICE_TRANSCRIBE_RESULT_UNCONFIRMED"
      },
      "image": {
        "completed_states": ["completed"],
        "unconfirmed_result": "failed",
        "unconfirmed_error_code": "IMAGE_UNDERSTANDING_RESULT_UNCONFIRMED"
      }
    },
    "rule": "OmniAuto owns action_phase and raw evidence; Worker is the only owner of result mapping. A missing per-item phase is conservatively treated as trigger_attempted and can never authorize a repeated physical action."
  },
  "item_outcome_contract": {
    "key_field": "source_message_key",
    "terminal_results": ["completed", "failed"],
    "merge_rule": "completed and failed outcomes are monotonic; later empty or partial results cannot erase prior outcomes",
    "conflict_rule": "a source_message_key cannot change terminal result inside one flow"
  },
  "sender_role_sources": [
    "same_row_avatar",
    "parent_voice",
    "system",
    "unknown"
  ],
  "item_states": ["completed", "failed"],
  "flow_states": ["completed", "partial", "failed", "cancelled"],
  "reply_text_contract": {
    "owner": "shared_machine_contract",
    "normalization": "unicode_whitespace_collapse",
    "hash": "sha256_utf8_canonical_text",
    "backend_behavior": "issue_only_canonical_text_and_hash",
    "worker_behavior": "reject_noncanonical_claim_and_ack_exact_hash"
  },
  "message_limits": {
    "content_max_chars": 20000,
    "raw_payload_max_bytes": 262144,
    "batch_max_items": 200,
    "ingest_max_bytes": 2097152,
    "split_target_bytes": 1572864,
    "raw_payload_transport_fields": [
      "contract_version",
      "contract_revision",
      "contract_sha256",
      "observation_schema_version",
      "source_message_key",
      "dedupe_confidence",
      "dedupe_basis",
      "message_position",
      "observation",
      "voice_transcription",
      "voice_transcription_meta",
      "voice_processing_reason",
      "voice_error_code",
      "transcribe_error_code",
      "voice_transcription_error_code",
      "ai_reply_receipt",
      "image_processing_reason",
      "customer_image_understanding",
      "visual_bridge_input"
    ],
    "observation_transport_fields": [
      "schema_version",
      "observation_id",
      "row_kind",
      "sender_role",
      "sender_role_source",
      "message_type",
      "voice_state",
      "content_clean",
      "source_message",
      "item_state",
      "action_phase",
      "voice_anchor_key",
      "parent_voice_anchor_key",
      "voice_processing_reason",
      "image_physical_anchor",
      "image_processing_reason",
      "customer_image_understanding",
      "visual_bridge_input",
      "bubble_rect",
      "contract_errors"
    ],
    "source_message_transport_fields": [
      "id",
      "canonical_visual_id",
      "canonical_input_id",
      "source_message_key",
      "message_type",
      "sender_role",
      "sender_role_source",
      "content",
      "content_clean",
      "bubble_rect",
      "rect",
      "voice_anchor_stable_key",
      "voice_anchor_key",
      "parent_voice_anchor_key",
      "image_physical_anchor",
      "item_state",
      "voice_state"
    ],
    "preflight_rule": "persist the original complete outbox before compaction, size validation, or partitioning; transport compaction may remove only fields outside these allowlists"
  },
  "row_rules": {
    "text_bubble": {
      "ingestible": true,
      "message_type": "text",
      "allowed_sender_roles": ["customer", "self"],
      "allowed_sender_role_sources": ["same_row_avatar"],
      "discovery_allowed_sender_roles": ["customer", "self", "system", "unknown"],
      "discovery_allowed_sender_role_sources": ["same_row_avatar", "system", "unknown"],
      "allowed_voice_states": ["not_voice"],
      "required_fields": ["observation_id", "row_kind", "sender_role", "sender_role_source", "message_type", "voice_state", "content_clean", "source_message"]
    },
    "voice_bubble": {
      "ingestible": false,
      "failed_ingestible": true,
      "message_type": "voice",
      "allowed_sender_roles": ["customer", "self"],
      "allowed_sender_role_sources": ["same_row_avatar"],
      "allowed_voice_states": ["untranscribed", "transcribed"],
      "required_fields": ["observation_id", "row_kind", "sender_role", "sender_role_source", "message_type", "voice_state"],
      "failed_required_fields": ["observation_id", "row_kind", "sender_role", "sender_role_source", "message_type", "voice_state", "item_state", "voice_anchor_key", "voice_processing_reason", "source_message"]
    },
    "voice_transcript": {
      "ingestible": true,
      "failed_ingestible": true,
      "message_type": "voice",
      "allowed_sender_roles": ["customer", "self"],
      "allowed_sender_role_sources": ["parent_voice"],
      "allowed_voice_states": ["transcribed"],
      "required_fields": ["observation_id", "row_kind", "sender_role", "sender_role_source", "message_type", "voice_state", "content_clean", "parent_voice_anchor_key", "source_message"],
      "failed_required_fields": ["observation_id", "row_kind", "sender_role", "sender_role_source", "message_type", "voice_state", "item_state", "parent_voice_anchor_key", "voice_processing_reason", "source_message"]
    },
    "image_bubble": {
      "ingestible": true,
      "failed_ingestible": true,
      "message_type": "image",
      "allowed_sender_roles": ["customer", "self"],
      "allowed_sender_role_sources": ["same_row_avatar"],
      "allowed_voice_states": ["not_voice"],
      "discovery_required_fields": ["observation_id", "row_kind", "sender_role", "sender_role_source", "message_type", "voice_state", "bubble_rect", "image_physical_anchor", "source_message"],
      "required_fields": ["observation_id", "row_kind", "sender_role", "sender_role_source", "message_type", "voice_state", "content_clean", "image_physical_anchor", "customer_image_understanding", "visual_bridge_input", "source_message"],
      "failed_required_fields": ["observation_id", "row_kind", "sender_role", "sender_role_source", "message_type", "voice_state", "item_state", "image_physical_anchor", "image_processing_reason", "source_message"],
      "terminal_non_ingestible_item_states": ["ignored"]
    },
    "system_message": {
      "ingestible": true,
      "message_type": "system",
      "allowed_sender_roles": ["system"],
      "allowed_sender_role_sources": ["system"],
      "allowed_voice_states": ["not_voice"],
      "required_fields": ["observation_id", "row_kind", "sender_role", "sender_role_source", "message_type", "voice_state", "content_clean", "source_message"]
    },
    "call_event": {
      "ingestible": false,
      "message_type": "system",
      "allowed_sender_roles": ["system"],
      "allowed_sender_role_sources": ["system"],
      "allowed_voice_states": ["not_voice"],
      "required_fields": ["observation_id", "row_kind", "sender_role", "sender_role_source", "message_type", "voice_state"]
    },
    "system_banner": {
      "ingestible": false,
      "message_type": "system",
      "allowed_sender_roles": ["system"],
      "allowed_sender_role_sources": ["system"],
      "allowed_voice_states": ["not_voice"],
      "required_fields": ["observation_id", "row_kind", "sender_role", "sender_role_source", "message_type", "voice_state"]
    },
    "unknown": {
      "ingestible": false,
      "message_type": "unknown",
      "allowed_sender_roles": ["unknown"],
      "allowed_sender_role_sources": ["unknown"],
      "allowed_voice_states": ["not_voice"],
      "required_fields": ["observation_id", "row_kind", "sender_role", "sender_role_source", "message_type", "voice_state"]
    }
  },
  "required_request_fields": [
    "contract_version",
    "contract_revision",
    "contract_sha256",
    "observation_schema_version",
    "read_run_id",
    "conversation_id",
    "remark_code",
    "authorization_revision",
    "messages",
    "evidence"
  ],
  "required_observation_fields": [
    "schema_version",
    "observation_id",
    "row_kind",
    "sender_role",
    "sender_role_source",
    "message_type",
    "voice_state"
  ],
  "required_canonical_message_fields": [
    "source_message_key",
    "dedupe_key",
    "sender_role_hint",
    "message_type",
    "message_position",
    "item_state",
    "flow_state",
    "raw_payload"
  ],
  "message_position_schema": {
    "required_fields": ["screen_order", "frame_source", "order_source"],
    "order_sources": ["visual_top", "observation_index_fallback"],
    "safety_rule": "screen_order may sort messages, but only visual_top may prove that one message is physically below another for state or handoff decisions"
  },
  "required_evidence_fields": [
    "contract_revision",
    "contract_sha256",
    "observation_schema_version",
    "authoritative_frame_source",
    "observations",
    "authorization_read_reason",
    "finished_at",
    "flow_gate_errors",
    "flow_gate_details"
  ],
  "optional_evidence_fields": [
    "continuation_batch_id",
    "continuation_token",
    "slot_ledger_states"
  ],
  "batch_continuation_rule": "continuation_batch_id and continuation_token must be present together and may only advance the exact backend-issued batch",
  "flow_gate_detail_schema": {
    "required_fields": ["error_code", "position_source"],
    "optional_position_fields": ["min_screen_order", "max_screen_order"],
    "optional_subject_fields": ["subject_sender_role"],
    "strong_position_sources": [
      "slot_ledger_visual_top",
      "identity_error_visual_top",
      "failed_image_visual_top",
      "failed_voice_visual_top"
    ],
    "weak_position_source": "position_unavailable",
    "position_rule": "a customer gate may be cleared only by a later human sales message; a failed self voice gate may also close at the same screen_order because that failed voice is itself the persisted human-sales fact"
  },
  "temporary_capability_gate_codes": [
    "C2_VISION_CAPABILITY_PAUSED",
    "C2_IMAGE_PROCESSING_DEFERRED",
    "C2_INGEST_PARTITION_INCOMPLETE"
  ],
  "temporary_capability_gate_rule": "temporary capability gates may persist message facts and block Brain, but must not create a handoff; after capability recovery the pending fact may be completed and resume the normal batch flow",
  "slot_ledger_state_schema": {
    "owner": "worker",
    "required_fields": [
      "observation_id",
      "screen_order",
      "order_source",
      "row_kind",
      "source_message_key",
      "ledger_state"
    ],
    "ledger_states": [
      "NEW_MESSAGE",
      "OUTBOX_WAITING",
      "OLD_FAILED",
      "OLD_COMPLETED"
    ],
    "order_sources": ["visual_top", "observation_index_fallback"],
    "identity_rule": "source_message_key is the only cross-round slot identity and screen_order is ordering evidence only",
    "safety_rule": "only visual_top is strong physical-order evidence; observation_index_fallback must never clear a flow gate or handoff",
    "uniqueness_rule": "source_message_key and screen_order must each be unique inside one authoritative frame"
  },
  "image_persistence_policy": {
    "allowed_raw_payload_fields": ["customer_image_understanding", "visual_bridge_input"],
    "customer_image_understanding_allowed_fields": [
      "schema_version",
      "enabled",
      "applied",
      "adoptable",
      "reason",
      "provider",
      "request_style",
      "model",
      "vision_summary",
      "image_ocr_text",
      "classification",
      "entities",
      "intent_hints",
      "bridge",
      "catalog_alignment",
      "audit"
    ],
    "visual_bridge_input_allowed_fields": [
      "present",
      "vision_summary",
      "classification",
      "catalog_assist",
      "intent_hints",
      "vehicle_image_retrieval",
      "source_message_ids"
    ],
    "customer_image_understanding_audit_allowed_fields": [
      "latency_ms",
      "used_fallback",
      "provider_error",
      "retry_error",
      "retry_after_non_json",
      "catalog_identity_candidate_count",
      "image_sha256"
    ],
    "forbidden_field_names": [
      "image_local_path",
      "image_recognition",
      "image_bytes",
      "bytes",
      "base64",
      "data_url",
      "thumbnail",
      "asset_id",
      "provider_response",
      "provider_response_text",
      "provider_response_diagnostics",
      "raw_provider_response",
      "retry_response_text",
      "retry_response_diagnostics",
      "original_image",
      "clipboard_image",
      "picture_ref"
    ],
    "text_only": true,
    "original_image_upload": false,
    "local_image_persistence": false
  },
  "ingest_response_contract": {
    "result_required_fields": [
      "source_message_key",
      "dedupe_key",
      "ingest_result"
    ],
    "ingest_results": ["ingested", "duplicated", "ignored"],
    "source_message_key_owner": "worker",
    "confirmation_rule": "worker_must_confirm_local_ledger_by_exact_source_message_key"
  },
  "outbox_recovery_contract": {
    "actions": [
      "retry",
      "refresh_and_rebuild",
      "rebuild_failed_facts",
      "split_and_retry",
      "capability_paused",
      "target_terminated",
      "conversation_terminated"
    ],
    "response_field": "data.recovery_action",
    "refresh_and_rebuild_codes": [
      "MESSAGE_AUTHORIZATION_REVISION_EXPIRED"
    ],
    "rebuild_failed_fact_codes": [
      "IMAGE_UNDERSTANDING_REQUIRED",
      "IMAGE_UNDERSTANDING_EVIDENCE_MISMATCH",
      "IMAGE_UNDERSTANDING_FIELD_INVALID",
      "IMAGE_UNDERSTANDING_SCHEMA_INVALID",
      "IMAGE_VISUAL_BRIDGE_FIELD_INVALID",
      "IMAGE_BRIDGE_EVIDENCE_MISMATCH",
      "IMAGE_FAILURE_REASON_MISSING",
      "VOICE_FAILURE_REASON_MISSING",
      "VOICE_FAILURE_REASON_MISMATCH",
      "VOICE_TRANSCRIBE_EMPTY",
      "VOICE_TRANSCRIBE_INVALID_CONTENT",
      "VOICE_FAILURE_CONTENT_INVALID"
    ],
    "split_and_retry_codes": [
      "MESSAGE_INGEST_REQUEST_TOO_LARGE"
    ],
    "target_terminated_codes": [
      "MESSAGE_CONVERSATION_NOT_BOUND",
      "MESSAGE_REMARK_MISMATCH",
      "CONVERSATION_STATUS_NOT_LISTENABLE"
    ],
    "conversation_terminated_codes": [
      "IMAGE_PERSISTENCE_FIELD_FORBIDDEN",
      "IMAGE_PERSISTENCE_VALUE_FORBIDDEN",
      "IMAGE_PERSISTENCE_VALUE_INVALID",
      "MESSAGE_AUTHORIZATION_READ_REASON_MISSING",
      "MESSAGE_BATCH_OBSERVATIONS_MISSING",
      "MESSAGE_DEDUPE_KEY_MISSING",
      "MESSAGE_FLOW_GATE_DETAIL_INVALID",
      "MESSAGE_FLOW_GATE_DETAIL_MISMATCH",
      "MESSAGE_FLOW_GATE_POSITION_INVALID",
      "MESSAGE_FLOW_GATE_SUBJECT_ROLE_INVALID",
      "MESSAGE_FLOW_STATE_INVALID",
      "MESSAGE_FRAME_SOURCE_INVALID",
      "MESSAGE_INGEST_PARTITION_GATE_MISSING",
      "MESSAGE_INGEST_PARTITION_GATE_STALE",
      "MESSAGE_INGEST_PARTITION_IDENTITY_MISMATCH",
      "MESSAGE_INGEST_PARTITION_SOURCE_MISMATCH",
      "MESSAGE_ITEM_STATE_INVALID",
      "MESSAGE_OBSERVATION_ID_CONFLICT",
      "MESSAGE_OBSERVATION_ID_MISSING",
      "MESSAGE_OBSERVATION_MISSING",
      "MESSAGE_OBSERVATION_REQUIRED_FIELD_MISSING",
      "MESSAGE_POSITION_MISSING",
      "MESSAGE_RAW_PAYLOAD_MISSING",
      "MESSAGE_RAW_SOURCE_IDENTITY_MISMATCH",
      "MESSAGE_ROW_CONTENT_MISMATCH",
      "MESSAGE_ROW_KIND_INVALID",
      "MESSAGE_ROW_KIND_NOT_INGESTIBLE",
      "MESSAGE_ROW_ROLE_SOURCE_UNTRUSTED",
      "MESSAGE_ROW_SENDER_ROLE_MISMATCH",
      "MESSAGE_ROW_TYPE_MISMATCH",
      "MESSAGE_ROW_VOICE_STATE_INVALID",
      "MESSAGE_SCREEN_ORDER_DUPLICATED",
      "MESSAGE_SENDER_ROLE_INVALID",
      "MESSAGE_SENDER_ROLE_UNCLEAR",
      "MESSAGE_SOURCE_IDENTITY_MISSING",
      "MESSAGE_TYPE_INVALID",
      "MESSAGE_TARGET_IDENTITY_MISSING",
      "MESSAGE_TARGET_IDENTITY_MISMATCH",
      "MESSAGE_OBSERVATION_CONTRACT_INVALID",
      "MESSAGE_OBSERVATION_EVIDENCE_MISMATCH",
      "MESSAGE_OBSERVATION_MAPPING_CONFLICT",
      "MESSAGE_OBSERVATION_MAPPING_INCOMPLETE",
      "MESSAGE_SOURCE_CONFLICT",
      "MESSAGE_FLOW_GATE_POSITION_SOURCE_UNTRUSTED"
    ],
    "capability_paused_codes": [
      "VALIDATION_ERROR",
      "MESSAGE_CONTRACT_V3_REQUIRED",
      "MESSAGE_CONTRACT_REVISION_MISMATCH",
      "MESSAGE_CONTRACT_SHA256_MISMATCH",
      "MESSAGE_OBSERVATION_SCHEMA_VERSION_MISMATCH",
      "MESSAGE_EVIDENCE_CONTRACT_REVISION_MISMATCH",
      "MESSAGE_EVIDENCE_CONTRACT_SHA256_MISMATCH",
      "MESSAGE_EVIDENCE_OBSERVATION_SCHEMA_MISMATCH",
      "MESSAGE_RAW_CONTRACT_VERSION_MISMATCH",
      "MESSAGE_RAW_CONTRACT_REVISION_MISMATCH",
      "MESSAGE_RAW_CONTRACT_SHA256_MISMATCH",
      "MESSAGE_RAW_OBSERVATION_SCHEMA_MISMATCH"
    ],
    "state_machine": {
      "states": [
        "waiting",
        "retry_waiting",
        "refresh_pending",
        "rebuild_pending",
        "split_pending",
        "capability_paused",
        "split_completed",
        "target_terminated",
        "conversation_terminated",
        "confirmed"
      ],
      "automatic_states": [
        "waiting",
        "retry_waiting",
        "refresh_pending",
        "rebuild_pending",
        "split_pending",
        "capability_paused"
      ],
      "state_properties": {
        "waiting": {
          "automatic_retry": true,
          "blocks_new_ui_actions": true,
          "manual_recovery": false
        },
        "retry_waiting": {
          "automatic_retry": true,
          "blocks_new_ui_actions": true,
          "manual_recovery": false
        },
        "refresh_pending": {
          "automatic_retry": true,
          "blocks_new_ui_actions": true,
          "manual_recovery": false
        },
        "rebuild_pending": {
          "automatic_retry": true,
          "blocks_new_ui_actions": true,
          "manual_recovery": false
        },
        "split_pending": {
          "automatic_retry": true,
          "blocks_new_ui_actions": true,
          "manual_recovery": false
        },
        "capability_paused": {
          "automatic_retry": true,
          "blocks_new_ui_actions": true,
          "manual_recovery": false
        },
        "split_completed": {
          "automatic_retry": false,
          "blocks_new_ui_actions": false,
          "manual_recovery": false
        },
        "target_terminated": {
          "automatic_retry": false,
          "blocks_new_ui_actions": false,
          "manual_recovery": false
        },
        "conversation_terminated": {
          "automatic_retry": false,
          "blocks_new_ui_actions": false,
          "manual_recovery": false
        },
        "confirmed": {
          "automatic_retry": false,
          "blocks_new_ui_actions": false,
          "manual_recovery": false
        }
      },
      "retry_backoff_seconds": [1, 2, 5, 10, 30, 60],
      "max_retry_interval_seconds": 60,
      "transitions": {
        "retry": "retry_waiting",
        "refresh_and_rebuild": "refresh_pending",
        "rebuild_failed_facts": "rebuild_pending",
        "split_and_retry": "split_pending",
        "capability_paused": "capability_paused",
        "split_completed": "split_completed",
        "target_terminated": "target_terminated",
        "conversation_terminated": "conversation_terminated",
        "refresh_succeeded": "waiting",
        "capability_recovered": "waiting",
        "confirmed": "confirmed"
      }
    },
    "retry_statuses": [408, 425, 429, 500, 502, 503, 504],
    "unknown_api_error_action": "capability_paused",
    "transport_error_action": "retry",
    "retryable_compatibility_rule": "data.retryable is display-only for legacy clients and must not drive new Worker recovery."
  },
  "message_identity_contract": {
    "source_message_key_owner": "worker",
    "dedupe_key_owner": "worker",
    "backend_behavior": "validate_and_persist_only",
    "omniauto_inputs": [
      "observation",
      "physical_anchor",
      "recognition_evidence"
    ],
    "forbidden_identity_inputs": [
      "scan_id",
      "read_run_id",
      "absolute_coordinates",
      "authorization_revision",
      "time_bucket"
    ],
    "legacy_transition": {
      "source_version": "v16.104",
      "backend_output": "read-targets.identity_transition.legacy_messages",
      "backend_output_policy": "always_return_versioned_transition_even_when_legacy_messages_is_empty",
      "worker_behavior": "reuse_exact_legacy_dedupe_key_once_then_persist_worker_sequence_mapping",
      "completion_rule": "set_legacy_transition_completed_only_after_versioned_backend_transition_is_processed",
      "backend_behavior": "database_unique_constraint_remains_final_dedupe",
      "ambiguous_behavior": "block_ingest_and_brain_then_report_idempotent_handoff",
      "forbidden_as_steady_state_identity": true
    },
    "identity_ambiguity_gate": {
      "worker_output": "messages/ingest.evidence.flow_gate_identity_key",
      "key_owner": "worker",
      "key_inputs": [
        "conversation_id",
        "error_code",
        "normalized_identity_errors"
      ],
      "backend_behavior": "create_one_idempotent_handoff_per_stable_gate_key",
      "worker_outbox_behavior": "reuse_one_stable_read_run_id_and_outbox_record_per_gate_key",
      "messages": [],
      "forbidden_identity_inputs": [
        "scan_id",
        "read_run_id",
        "absolute_coordinates",
        "authorization_revision",
        "time_bucket"
      ]
    }
  },
  "session_scan_identity_contract": {
    "owner": "omniauto",
    "required_field": "rpa_session_key",
    "worker_behavior": "forward_only_when_present",
    "missing_behavior": "exclude_from_scan_result_and_record_missing_session_key_excluded_count",
    "forbidden_behavior": "worker_must_not_synthesize_session_identity_from_title_index_or_preview"
  }
}
