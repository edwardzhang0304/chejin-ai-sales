      "VOICE_FAILURE_REASON_MISMATCH",
      "VOICE_TRANSCRIBE_EMPTY",
      "VOICE_TRANSCRIBE_INVALID_CONTENT",
      "VOICE_FAILURE_CONTENT_INVALID"
    ],
    "split_and_retry_codes": [
      "MESSAGE_INGEST_REQUEST_TOO_LARGE"
    ],
    "target_terminated_codes": [
