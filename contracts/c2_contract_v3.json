{
  "contract_version": 3,
  "contract_revision": "3.13.2",
  "observation_schema_version": 3,
  "control_schema_version": 1,
  "sender_roles": ["customer", "self", "system", "unknown"],
  "message_types": ["text", "image", "voice", "system", "file", "unknown"],
  "row_kinds": [
    "text_bubble",
    "voice_bubble",
    "voice_transcript",
    "image_bubble",
    "system_message",
    "call_event",
    "system_banner",
    "unknown"
  ],
  "ingestible_row_kinds": [
    "text_bubble",
    "voice_transcript",
    "image_bubble",
    "system_message"
  ],
  "chat_message_row_kinds": ["text_bubble", "voice_transcript", "image_bubble"],
  "voice_states": ["not_voice", "untranscribed", "transcribed"],
  "action_phases": [
    "not_attempted",
    "cancelled_before_trigger",
    "trigger_attempted",
    "failed",
    "confirmed",
    "quarantined"
  ],
  "action_result_contract": {
    "send": {
      "not_attempted": "failed",
      "trigger_attempted": "unknown",
      "confirmed": "sent"
    },
    "voice": {
      "not_attempted": "failed",
      "cancelled_before_trigger": "failed",
      "trigger_attempted": "failed",
      "failed": "failed",
      "confirmed": "completed",
      "quarantined": "failed"
    },
    "image": {
      "not_attempted": "failed",
      "trigger_attempted": "failed",
      "confirmed": "completed"
    },
    "unknown_error_codes": {
      "send": "SEND_RESULT_UNKNOWN",
      "voice": "VOICE_TRANSCRIBE_RESULT_UNKNOWN",
      "image": "IMAGE_COPY_RESULT_UNKNOWN"
    },
    "missing_phase_fallback": "trigger_attempted",
    "business_completion": {
      "send": {
        "completed_states": ["sent"],
        "unconfirmed_result": "unknown",
        "unconfirmed_error_code": "SEND_RESULT_UNKNOWN"
      },
      "voice": {
        "completed_states": ["completed"],
        "unconfirmed_result": "failed",
        "unconfirmed_error_code": "VOICE_TRANSCRIBE_RESULT_UNCONFIRMED"
      },
      "image": {
        "completed_states": ["completed"],
        "unconfirmed_result": "failed",
        "unconfirmed_error_code": "IMAGE_UNDERSTANDING_RESULT_UNCONFIRMED"
      }
    },
    "rule": "OmniAuto owns action_phase and raw evidence; Worker is the only owner of result mapping. A missing per-item phase is conservatively treated as trigger_attempted and can never authorize a repeated physical action."
  },
  "item_outcome_contract": {
    "key_field": "source_message_key",
    "terminal_results": ["completed", "failed"],
    "merge_rule": "completed and failed outcomes are monotonic; later empty or partial results cannot erase prior outcomes",
    "conflict_rule": "a source_message_key cannot change terminal result inside one flow"
  },
  "sender_role_sources": [
    "same_row_avatar",
    "parent_voice",
    "system",
    "unknown"
  ],
  "item_states": ["completed", "failed"],
  "flow_states": ["completed", "partial", "failed", "cancelled"],
  "reply_text_contract": {
    "owner": "shared_machine_contract",
    "normalization": "unicode_whitespace_collapse",
    "hash": "sha256_utf8_canonical_text",
    "backend_behavior": "issue_only_canonical_text_and_hash",
    "worker_behavior": "reject_noncanonical_claim_and_ack_exact_hash"
  },
  "message_limits": {
    "content_max_chars": 20000,
    "raw_payload_max_bytes": 262144,
    "batch_max_items": 200,
    "ingest_max_bytes": 2097152,
    "split_target_bytes": 1572864,
    "raw_payload_transport_fields": [
      "contract_version",
      "contract_revision",
      "contract_sha256",
      "observation_schema_version",
      "source_message_key",
      "dedupe_confidence",
      "dedupe_basis",
      "message_position",
      "observation",
      "voice_transcription",
      "voice_transcription_meta",
      "error_code",
      "reason_detail",
      "ai_reply_receipt",
      "customer_image_understanding",
      "visual_bridge_input"
    ],
    "observation_transport_fields": [
      "schema_version",
      "observation_id",
      "row_kind",
      "sender_role",
      "sender_role_source",
      "message_type",
      "voice_state",
      "content_clean",
      "source_message",
      "item_state",
      "action_phase",
      "voice_anchor_key",
      "parent_voice_anchor_key",
      "error_code",
      "reason_detail",
      "image_physical_anchor",
      "customer_image_understanding",
      "visual_bridge_input",
      "bubble_rect",
      "contract_errors"
    ],
    "source_message_transport_fields": [
      "id",
      "canonical_visual_id",
      "canonical_input_id",
      "source_message_key",
      "message_type",
      "sender_role",
      "sender_role_source",
      "content",
      "content_clean",
      "bubble_rect",
      "rect",
      "voice_anchor_stable_key",
      "voice_anchor_key",
      "parent_voice_anchor_key",
      "image_physical_anchor",
      "item_state",
      "voice_state"
    ],
    "preflight_rule": "persist the original complete outbox before compaction, size validation, or partitioning; transport compaction may remove only fields outside these allowlists"
  },
  "row_rules": {
    "text_bubble": {
      "ingestible": true,
      "message_type": "text",
      "allowed_sender_roles": ["customer", "self"],
      "allowed_sender_role_sources": ["same_row_avatar"],
      "discovery_allowed_sender_roles": ["customer", "self", "system", "unknown"],
      "discovery_allowed_sender_role_sources": ["same_row_avatar", "system", "unknown"],
      "allowed_voice_states": ["not_voice"],
      "required_fields": ["observation_id", "row_kind", "sender_role", "sender_role_source", "message_type", "voice_state", "content_clean", "source_message"]
    },
    "voice_bubble": {
      "ingestible": false,
      "failed_ingestible": true,
      "message_type": "voice",
      "allowed_sender_roles": ["customer", "self"],
      "allowed_sender_role_sources": ["same_row_avatar"],
      "allowed_voice_states": ["untranscribed", "transcribed"],
      "required_fields": ["observation_id", "row_kind", "sender_role", "sender_role_source", "message_type", "voice_state"],
      "failed_required_fields": ["observation_id", "row_kind", "sender_role", "sender_role_source", "message_type", "voice_state", "item_state", "voice_anchor_key", "error_code", "reason_detail", "source_message"]
    },
    "voice_transcript": {
      "ingestible": true,
      "failed_ingestible": true,
      "message_type": "voice",
      "allowed_sender_roles": ["customer", "self"],
      "allowed_sender_role_sources": ["parent_voice"],
      "allowed_voice_states": ["transcribed"],
      "required_fields": ["observation_id", "row_kind", "sender_role", "sender_role_source", "message_type", "voice_state", "content_clean", "parent_voice_anchor_key", "source_message"],
      "failed_required_fields": ["observation_id", "row_kind", "sender_role", "sender_role_source", "message_type", "voice_state", "item_state", "parent_voice_anchor_key", "error_code", "reason_detail", "source_message"]
    },
    "image_bubble": {
      "ingestible": true,
      "failed_ingestible": true,
      "message_type": "image",
      "allowed_sender_roles": ["customer", "self"],
      "allowed_sender_role_sources": ["same_row_avatar"],
      "allowed_voice_states": ["not_voice"],
      "discovery_required_fields": ["observation_id", "row_kind", "sender_role", "sender_role_source", "message_type", "voice_state", "bubble_rect", "image_physical_anchor", "source_message"],
      "required_fields": ["observation_id", "row_kind", "sender_role", "sender_role_source", "message_type", "voice_state", "content_clean", "image_physical_anchor", "customer_image_understanding", "visual_bridge_input", "source_message"],
      "failed_required_fields": ["observation_id", "row_kind", "sender_role", "sender_role_source", "message_type", "voice_state", "item_state", "image_physical_anchor", "error_code", "reason_detail", "source_message"],
      "terminal_non_ingestible_item_states": []
    },
    "system_message": {
      "ingestible": true,
      "message_type": "system",
      "allowed_sender_roles": ["system"],
      "allowed_sender_role_sources": ["system"],
      "allowed_voice_states": ["not_voice"],
      "required_fields": ["observation_id", "row_kind", "sender_role", "sender_role_source", "message_type", "voice_state", "content_clean", "source_message"]
    },
    "call_event": {
      "ingestible": false,
      "message_type": "system",
      "allowed_sender_roles": ["system"],
      "allowed_sender_role_sources": ["system"],
      "allowed_voice_states": ["not_voice"],
      "required_fields": ["observation_id", "row_kind", "sender_role", "sender_role_source", "message_type", "voice_state"]
    },
    "system_banner": {
      "ingestible": false,
      "message_type": "system",
      "allowed_sender_roles": ["system"],
      "allowed_sender_role_sources": ["system"],
      "allowed_voice_states": ["not_voice"],
      "required_fields": ["observation_id", "row_kind", "sender_role", "sender_role_source", "message_type", "voice_state"]
    },
    "unknown": {
      "ingestible": false,
      "message_type": "unknown",
      "allowed_sender_roles": ["unknown"],
      "allowed_sender_role_sources": ["unknown"],
      "allowed_voice_states": ["not_voice"],
      "required_fields": ["observation_id", "row_kind", "sender_role", "sender_role_source", "message_type", "voice_state"]
    }
  },
  "required_request_fields": [
    "contract_version",
    "contract_revision",
    "contract_sha256",
    "observation_schema_version",
    "read_run_id",
    "conversation_id",
    "remark_code",
    "authorization_revision",
    "messages",
    "evidence"
  ],
  "required_observation_fields": [
    "schema_version",
    "observation_id",
    "row_kind",
    "sender_role",
    "sender_role_source",
    "message_type",
    "voice_state"
  ],
  "required_canonical_message_fields": [
    "source_message_key",
    "dedupe_key",
    "sender_role_hint",
    "message_type",
    "message_position",
    "item_state",
    "flow_state",
    "raw_payload"
  ],
  "message_position_schema": {
    "required_fields": ["screen_order", "frame_source", "order_source"],
    "order_sources": ["visual_top", "observation_index_fallback"],
    "safety_rule": "screen_order may sort messages, but only visual_top may prove that one message is physically below another for state or handoff decisions"
  },
  "authoritative_frame_source_values": [
    "initial_read",
    "final_read",
    "action_journal_recovery"
  ],
  "authoritative_frame_source_contract": {
    "owner": "worker",
    "initial_read_rule": "allowed only when no voice or image UI action invalidated the initial complete frame; the original payload and observations must be preserved",
    "final_read_rule": "required when the initial complete frame was invalidated by any voice or image UI action or by an observed concurrent page change, and must represent the latest stable complete frame before ingest or Brain",
    "action_journal_recovery_rule": "allowed only for fact settlement reconstructed without reading or operating the current WeChat UI",
    "voice_orchestrator_entry_rule": "voice prepare or execute may be called only when the current authoritative observations contain an executable untranscribed voice not already terminally settled",
    "forbidden_values": ["voice_execute_final"],
    "invalid_error_code": "C2_AUTHORITATIVE_FRAME_SOURCE_INVALID"
  },
  "required_evidence_fields": [
    "contract_revision",
    "contract_sha256",
    "observation_schema_version",
    "authoritative_frame_source",
    "observations",
    "authorization_read_reason",
    "finished_at",
    "flow_gate_errors",
    "flow_gate_details",
    "slot_ledger_states",
    "sequence_alignment_evidence"
  ],
  "optional_evidence_fields": [
    "continuation_batch_id",
    "continuation_token"
  ],
  "batch_continuation_rule": "continuation_batch_id and continuation_token must be present together and may only advance the exact backend-issued batch",
  "flow_gate_detail_schema": {
    "required_fields": ["error_code", "position_source"],
    "optional_position_fields": ["min_screen_order", "max_screen_order"],
    "optional_subject_fields": ["subject_sender_role"],
    "strong_position_sources": [
      "slot_ledger_visual_top",
      "identity_error_visual_top",
      "failed_image_visual_top",
      "failed_voice_visual_top"
    ],
    "weak_position_source": "position_unavailable",
    "position_rule": "a customer gate may be cleared only by a later human sales message; a failed self voice gate may also close at the same screen_order because that failed voice is itself the persisted human-sales fact"
  },
  "temporary_capability_gate_codes": [
    "C2_INGEST_PARTITION_INCOMPLETE"
  ],
  "retired_flow_gate_codes": [
    "C2_VISION_CAPABILITY_PAUSED",
    "C2_IMAGE_PROCESSING_DEFERRED"
  ],
  "temporary_capability_gate_rule": "temporary capability gates are request-level protocol gates only; Vision configuration and individual image processing must never use this mechanism",
  "flow_gate_action_contract": {
    "classes": [
      "non_blocking_warning",
      "item_handoff",
      "recoverable_hold",
      "hard_stop"
    ],
    "customer_media_failure": "settle_each_failed_fact_then_handoff_without_brain_or_automatic_clarification",
    "self_media_failure": "persist_warning_and_continue_latest_complete_customer_tail",
    "recoverable_identity_history": "close_matching_temporary_handoff_after_authoritative_clean_read",
    "high_intent": "notify_sales_by_handoff_event_and_enter_waiting_sales_reply_without_normal_ai_reply",
    "high_intent_reason_code": "CUSTOMER_HIGH_INTENT"
  },
  "slot_ledger_state_schema": {
    "owner": "worker",
    "required_fields": [
      "observation_id",
      "screen_order",
      "order_source",
      "row_kind",
      "source_message_key",
      "origin_read_run_id",
      "fact_scope",
      "delivery_state",
      "item_state"
    ],
    "fact_scopes": [
      "current_read_run",
      "historical",
      "unknown"
    ],
    "delivery_states": [
      "not_enqueued",
      "outbox_waiting",
      "backend_confirmed"
    ],
    "item_states": [
      "completed",
      "failed"
    ],
    "legacy_display_ledger_states": [
      "NEW_MESSAGE",
      "OUTBOX_WAITING",
      "OLD_FAILED",
      "OLD_COMPLETED"
    ],
    "order_sources": ["visual_top", "observation_index_fallback"],
    "identity_rule": "source_message_key is the only cross-round slot identity and screen_order is ordering evidence only",
    "read_run_ownership_rule": "origin_read_run_id is immutable fact ownership; fact_scope is derived only by comparing it with the active read_run_id",
    "delivery_independence_rule": "delivery_state and item_state must never determine fact_scope or history continuity",
    "legacy_display_rule": "legacy ledger_state may be emitted only for logs and compatibility display; business gates must not read it",
    "history_gap_rule": "only a historical slot below a current_read_run slot is C2_MESSAGE_HISTORY_GAP; unknown is an identity gate",
    "safety_rule": "only visual_top is strong physical-order evidence; observation_index_fallback must never clear a flow gate or handoff",
    "uniqueness_rule": "source_message_key and screen_order must each be unique inside one authoritative frame"
  },
  "image_contract": {
    "source_limits": {
      "max_encoded_source_bytes": 12582912,
      "max_decoded_pixels": 20000000,
      "max_decoded_rgba_bytes": 80000000,
      "max_provider_payload_bytes": 3145728,
      "max_provider_edge_px": 2048,
      "max_visible_image_candidates": 64,
      "clipboard_no_progress_timeout_seconds": 15
    },
    "provider_contract": {
      "api_key_env": "CUSTOMER_IMAGE_UNDERSTANDING_API_KEY",
      "max_provider_attempts": 2,
      "process_overhead_seconds": 15,
      "production_requires_https": true,
      "development_modes": ["dev", "test", "development", "mock"],
      "development_http_hosts": ["127.0.0.1", "localhost"],
      "allowed_combinations": [
        {
          "provider": "anthropic_compatible",
          "host": "aiself.vip",
          "request_style": "anthropic_messages_vision",
          "models": ["doubao-seed-2-0-lite-260428"]
        }
      ]
    },
    "error_codes": [
      "C2_IMAGE_OBSERVATION_FAILED",
      "C2_IMAGE_SLOT_RECONFIRM_FAILED",
      "C2_IMAGE_MENU_OPERATION_FAILED",
      "C2_IMAGE_SOURCE_INVALID",
      "C2_IMAGE_PROVIDER_PAYLOAD_TOO_LARGE",
      "C2_IMAGE_CLIPBOARD_TRANSACTION_FAILED",
      "C2_IMAGE_CLIPBOARD_CLEAR_FAILED",
      "C2_IMAGE_VISION_CONFIG_INVALID",
      "C2_IMAGE_UNDERSTANDING_SCHEMA_INVALID",
      "C2_IMAGE_UNDERSTANDING_FAILED"
    ],
    "default_failure_error_code": "C2_IMAGE_UNDERSTANDING_FAILED",
    "failure_reason_to_error_code": {
      "C2_IMAGE_OBSERVATION_FAILED": "C2_IMAGE_OBSERVATION_FAILED",
      "vision_host_ports_incomplete": "C2_IMAGE_OBSERVATION_FAILED",
      "vision_window_context_capture_missing": "C2_IMAGE_OBSERVATION_FAILED",
      "vision_window_capture_failed": "C2_IMAGE_OBSERVATION_FAILED",
      "vision_window_frame_finalize_failed": "C2_IMAGE_OBSERVATION_FAILED",
      "vision_window_ocr_failed": "C2_IMAGE_OBSERVATION_FAILED",
      "vision_window_context_missing": "C2_IMAGE_OBSERVATION_FAILED",
      "vision_window_frame_unavailable": "C2_IMAGE_OBSERVATION_FAILED",
      "vision_window_frame_invalid": "C2_IMAGE_OBSERVATION_FAILED",
      "vision_window_message_parse_failed": "C2_IMAGE_OBSERVATION_FAILED",
      "C2_IMAGE_SLOT_RECONFIRM_FAILED": "C2_IMAGE_SLOT_RECONFIRM_FAILED",
      "MESSAGE_IDENTITY_UNCONFIRMED": "C2_IMAGE_SLOT_RECONFIRM_FAILED",
      "image_sender_role_untrusted": "C2_IMAGE_SLOT_RECONFIRM_FAILED",
      "image_slot_identity_missing": "C2_IMAGE_SLOT_RECONFIRM_FAILED",
      "image_bubble_rect_missing": "C2_IMAGE_SLOT_RECONFIRM_FAILED",
      "image_clipboard_side_filter_invalid": "C2_IMAGE_SLOT_RECONFIRM_FAILED",
      "vision_target_confirmation_failed": "C2_IMAGE_SLOT_RECONFIRM_FAILED",
      "image_bubble_not_visible_after_refresh": "C2_IMAGE_SLOT_RECONFIRM_FAILED",
      "image_bubble_current_bounds_missing": "C2_IMAGE_SLOT_RECONFIRM_FAILED",
      "image_bubble_clipboard_fingerprint_missing": "C2_IMAGE_SLOT_RECONFIRM_FAILED",
      "C2_IMAGE_MENU_OPERATION_FAILED": "C2_IMAGE_MENU_OPERATION_FAILED",
      "image_context_menu_screen_click_unavailable": "C2_IMAGE_MENU_OPERATION_FAILED",
      "C2_IMAGE_SOURCE_INVALID": "C2_IMAGE_SOURCE_INVALID",
      "clipboard_current_content_not_bitmap": "C2_IMAGE_SOURCE_INVALID",
      "clipboard_current_image_invalid": "C2_IMAGE_SOURCE_INVALID",
      "image_decode_failed": "C2_IMAGE_SOURCE_INVALID",
      "image_pixel_limit_exceeded": "C2_IMAGE_SOURCE_INVALID",
      "C2_IMAGE_PROVIDER_PAYLOAD_TOO_LARGE": "C2_IMAGE_PROVIDER_PAYLOAD_TOO_LARGE",
      "image_provider_payload_too_large": "C2_IMAGE_PROVIDER_PAYLOAD_TOO_LARGE",
      "C2_IMAGE_CLIPBOARD_TRANSACTION_FAILED": "C2_IMAGE_CLIPBOARD_TRANSACTION_FAILED",
      "clipboard_sequence_missing_before_copy": "C2_IMAGE_CLIPBOARD_TRANSACTION_FAILED",
      "clipboard_sequence_unchanged_after_copy": "C2_IMAGE_CLIPBOARD_TRANSACTION_FAILED",
      "clipboard_sequence_changed_during_read": "C2_IMAGE_CLIPBOARD_TRANSACTION_FAILED",
      "clipboard_replaced_by_external": "C2_IMAGE_CLIPBOARD_TRANSACTION_FAILED",
      "clipboard_image_fingerprint_mismatch": "C2_IMAGE_CLIPBOARD_TRANSACTION_FAILED",
      "image_clipboard_transaction_lock_timeout": "C2_IMAGE_CLIPBOARD_TRANSACTION_FAILED",
      "vision_cancelled": "C2_IMAGE_CLIPBOARD_TRANSACTION_FAILED",
      "vision_cancelled_before_start": "C2_IMAGE_CLIPBOARD_TRANSACTION_FAILED",
      "vision_cancelled_after_provider": "C2_IMAGE_CLIPBOARD_TRANSACTION_FAILED",
      "vision_port_transaction_exception": "C2_IMAGE_CLIPBOARD_TRANSACTION_FAILED",
      "C2_IMAGE_CLIPBOARD_CLEAR_FAILED": "C2_IMAGE_CLIPBOARD_CLEAR_FAILED",
      "clipboard_clear_port_missing": "C2_IMAGE_CLIPBOARD_CLEAR_FAILED",
      "clipboard_clear_exception": "C2_IMAGE_CLIPBOARD_CLEAR_FAILED",
      "clipboard_clear_invalid_result": "C2_IMAGE_CLIPBOARD_CLEAR_FAILED",
      "clipboard_clear_failed": "C2_IMAGE_CLIPBOARD_CLEAR_FAILED",
      "C2_IMAGE_VISION_CONFIG_INVALID": "C2_IMAGE_VISION_CONFIG_INVALID",
      "vision_configuration_incomplete": "C2_IMAGE_VISION_CONFIG_INVALID",
      "vision_configuration_invalid": "C2_IMAGE_VISION_CONFIG_INVALID",
      "customer_image_understanding_provider_not_configured": "C2_IMAGE_VISION_CONFIG_INVALID",
      "C2_IMAGE_UNDERSTANDING_SCHEMA_INVALID": "C2_IMAGE_UNDERSTANDING_SCHEMA_INVALID",
      "image_understanding_contract_invalid": "C2_IMAGE_UNDERSTANDING_SCHEMA_INVALID",
      "image_understanding_text_missing": "C2_IMAGE_UNDERSTANDING_SCHEMA_INVALID",
      "C2_IMAGE_UNDERSTANDING_FAILED": "C2_IMAGE_UNDERSTANDING_FAILED",
      "customer_image_understanding_provider_failed": "C2_IMAGE_UNDERSTANDING_FAILED",
      "vision_plugin_exception": "C2_IMAGE_UNDERSTANDING_FAILED",
      "vision_provider_exception": "C2_IMAGE_UNDERSTANDING_FAILED",
      "vision_result_invalid": "C2_IMAGE_UNDERSTANDING_FAILED",
      "vision_understanding_missing": "C2_IMAGE_UNDERSTANDING_FAILED"
    },
    "schemas": {
      "customer_image_understanding_v1": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "enabled",
          "applied",
          "adoptable",
          "reason",
          "provider",
          "request_style",
          "model",
          "vision_summary",
          "image_ocr_text",
          "classification",
          "entities",
          "intent_hints",
          "bridge",
          "catalog_alignment",
          "audit"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "applied": {"const": true}
              },
              "required": ["applied"]
            },
            "then": {
              "properties": {
                "vision_summary": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          }
        ],
        "properties": {
          "schema_version": {"type": "integer", "const": 1},
          "enabled": {"type": "boolean"},
          "applied": {"type": "boolean"},
          "adoptable": {"type": "boolean"},
          "reason": {"type": "string", "maxLength": 160},
          "provider": {"type": "string", "maxLength": 300},
          "request_style": {
            "type": "string",
            "enum": ["anthropic_messages_vision", "openai_chat_vision"]
          },
          "model": {"type": "string", "maxLength": 160},
          "vision_summary": {"type": "string", "maxLength": 2000},
          "image_ocr_text": {
            "type": "array",
            "maxItems": 20,
            "items": {"type": "string", "maxLength": 500}
          },
          "classification": {
            "type": "object",
            "additionalProperties": false,
            "required": ["is_vehicle", "vehicle_confidence", "unknown", "non_vehicle_reason"],
            "properties": {
              "is_vehicle": {"type": "boolean"},
              "vehicle_confidence": {"type": "number", "minimum": 0, "maximum": 1},
              "unknown": {"type": "boolean"},
              "non_vehicle_reason": {"type": "string", "maxLength": 300}
            }
          },
          "entities": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "brand_candidates",
              "series_candidates",
              "model_clues",
              "body_type",
              "color",
              "year_clues"
            ],
            "properties": {
              "brand_candidates": {
                "type": "array",
                "maxItems": 8,
                "items": {"type": "string", "maxLength": 120}
              },
              "series_candidates": {
                "type": "array",
                "maxItems": 8,
                "items": {"type": "string", "maxLength": 120}
              },
              "model_clues": {
                "type": "array",
                "maxItems": 12,
                "items": {"type": "string", "maxLength": 200}
              },
              "body_type": {"type": "string", "maxLength": 120},
              "color": {"type": "string", "maxLength": 120},
              "year_clues": {
                "type": "array",
                "maxItems": 8,
                "items": {"type": "string", "maxLength": 60}
              }
            }
          },
          "intent_hints": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "wants_catalog_match",
              "wants_similar_recommendation",
              "wants_general_chat",
              "needs_clarification"
            ],
            "properties": {
              "wants_catalog_match": {"type": "boolean"},
              "wants_similar_recommendation": {"type": "boolean"},
              "wants_general_chat": {"type": "boolean"},
              "needs_clarification": {"type": "boolean"}
            }
          },
          "bridge": {
            "type": "object",
            "additionalProperties": false,
            "required": ["normalized_vehicle_query", "brain_mode", "catalog_lookup_mode"],
            "properties": {
              "normalized_vehicle_query": {"type": "string", "maxLength": 500},
              "brain_mode": {"type": "string", "maxLength": 120},
              "catalog_lookup_mode": {"type": "string", "maxLength": 120}
            }
          },
          "catalog_alignment": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "selected_product_id",
              "selected_product_name",
              "alignment_confidence",
              "alignment_reason",
              "uncertain_reason"
            ],
            "properties": {
              "selected_product_id": {"type": "string", "maxLength": 128},
              "selected_product_name": {"type": "string", "maxLength": 200},
              "alignment_confidence": {"type": "number", "minimum": 0, "maximum": 1},
              "alignment_reason": {"type": "string", "maxLength": 500},
              "uncertain_reason": {"type": "string", "maxLength": 500}
            }
          },
          "audit": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "latency_ms",
              "used_fallback",
              "provider_error",
              "retry_error",
              "retry_after_non_json",
              "catalog_identity_candidate_count"
            ],
            "properties": {
              "latency_ms": {"type": "integer", "minimum": 0, "maximum": 3600000},
              "used_fallback": {"type": "boolean"},
              "provider_error": {"type": "string", "maxLength": 128},
              "retry_error": {"type": "string", "maxLength": 128},
              "retry_after_non_json": {"type": "boolean"},
              "catalog_identity_candidate_count": {"type": "integer", "minimum": 0, "maximum": 1000},
              "image_sha256": {"type": "string", "pattern": "^(|[0-9a-f]{64})$"}
            }
          }
        }
      },
      "visual_bridge_input_v1": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "present",
          "vision_summary",
          "classification",
          "catalog_assist",
          "intent_hints",
          "vehicle_image_retrieval",
          "source_message_ids"
        ],
        "properties": {
          "schema_version": {"type": "integer", "const": 1},
          "present": {"type": "boolean"},
          "vision_summary": {"type": "string", "maxLength": 2000},
          "classification": {
            "type": "object",
            "additionalProperties": false,
            "required": ["is_vehicle", "vehicle_confidence", "unknown"],
            "properties": {
              "is_vehicle": {"type": "boolean"},
              "vehicle_confidence": {"type": "number", "minimum": 0, "maximum": 1},
              "unknown": {"type": "boolean"}
            }
          },
          "catalog_assist": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "normalized_vehicle_query",
              "candidate_names",
              "exact_candidate_name"
            ],
            "properties": {
              "normalized_vehicle_query": {"type": "string", "maxLength": 500},
              "candidate_names": {
                "type": "array",
                "maxItems": 3,
                "items": {"type": "string", "maxLength": 200}
              },
              "exact_candidate_name": {"type": "string", "maxLength": 200}
            }
          },
          "intent_hints": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "wants_catalog_match",
              "wants_similar_recommendation",
              "needs_clarification"
            ],
            "properties": {
              "wants_catalog_match": {"type": "boolean"},
              "wants_similar_recommendation": {"type": "boolean"},
              "needs_clarification": {"type": "boolean"}
            }
          },
          "vehicle_image_retrieval": {
            "type": "object",
            "additionalProperties": false,
            "required": ["matched", "candidate_names"],
            "properties": {
              "matched": {"type": "boolean"},
              "candidate_names": {
                "type": "array",
                "maxItems": 3,
                "items": {"type": "string", "maxLength": 200}
              }
            }
          },
          "source_message_ids": {
            "type": "array",
            "maxItems": 3,
            "items": {"type": "string", "maxLength": 128}
          }
        }
      }
    }
  },
