# backend/Dockerfile uses the repository root as its build context.
# Send only the inputs explicitly copied by that Dockerfile.
**
!backend/
!backend/requirements.txt
!backend/app/
!backend/app/**
!backend/alembic.ini
!backend/alembic/
!backend/alembic/**
!backend/configs/
!backend/configs/**
!backend/scripts/
!backend/scripts/**
!backend/docker/
!backend/docker/entrypoint.sh
!contracts/
!contracts/c2_contract_v3.json
!worker-client/
!worker-client/omniauto-rpa/
!worker-client/omniauto-rpa/**

# Local secrets and generated state are never image inputs.
**/.git
**/.venv
**/node_modules
**/__pycache__
**/.pytest_cache
**/runtime
**/cache
**/artifacts
**/dist
**/build
**/.env
**/.env.*
**/*.env
**/*.env.*
**/vision-runtime.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.pyc
**/*.pyo
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.log
**/*.zip
