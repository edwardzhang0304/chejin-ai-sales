API_PORT=8000
ENVIRONMENT=development

POSTGRES_DB=chejin_leads
POSTGRES_USER=chejin
POSTGRES_PASSWORD=change_me_dev_password
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://chejin:change_me_dev_password@db:5432/chejin_leads

# Generate independent random values before any shared/staging/production use, for example:
# openssl rand -hex 32
PHONE_HASH_SECRET=dev_only_replace_with_random_hash_secret
CONTACT_ENCRYPTION_SECRET=dev_only_replace_with_random_contact_secret
EXPORT_MAX_ROWS=1000

# Use Alembic migrations by default. Do not enable auto table creation in shared/staging/production environments.
AUTO_CREATE_TABLES=false

# Disable API docs in production unless explicitly needed behind auth/VPN.
DOCS_ENABLED=true

# 后台账号由服务端命令创建。不要在此文件、Git 或镜像中写默认账号和密码。
# 正式环境必须为 true；本地 HTTP 开发为 false。
ADMIN_COOKIE_SECURE=false
INTERNAL_SERVICE_TOKEN=dev-only-internal-service-token-change-before-production
ADMIN_SESSION_IDLE_SECONDS=43200
ADMIN_SESSION_ABSOLUTE_SECONDS=604800
ADMIN_SESSION_TOUCH_INTERVAL_SECONDS=300
ADMIN_LOGIN_RATE_WINDOW_SECONDS=900
ADMIN_LOGIN_USERNAME_MAX_FAILURES=5
ADMIN_LOGIN_IP_MAX_FAILURES=20
ADMIN_LOGIN_BLOCK_BASE_SECONDS=30
ADMIN_LOGIN_BLOCK_MAX_SECONDS=900

# C3 AI Adapter:
# mock is only for backend workflow integration tests; formal delivery must use real OmniAuto AI Engine.
C3_AI_ADAPTER_MODE=real
C3_OMNIAUTO_CONFIG_PATH=/app/configs/chejin_c3_brain.json
# C3 Brain is fixed to DeepSeek. Keep the token in the runtime environment
# only; never commit it. Cross-provider fallback is intentionally disabled.
LLM_PROVIDER=deepseek
LLM_FALLBACK_ENABLED=false
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_FLASH_REASONING_EFFORT=low
DEEPSEEK_PRO_REASONING_EFFORT=high
DEEPSEEK_API_KEY=
C3_REPLY_ACTION_TTL_SECONDS=300
# Must exceed OmniAuto's bounded primary + fallback model budgets so Brain can
# return its structured retry_later result instead of losing the audit snapshot.
C3_BRAIN_PROVIDER_TIMEOUT_SECONDS=180
# Must be longer than the provider timeout. A stale active batch is recovered
# once, then terminalized instead of leaving the Worker holding the UI lock.
C3_BATCH_STALE_AFTER_SECONDS=240
C3_BATCH_RECOVERY_MAX_ATTEMPTS=2
# A provider-level retry is persisted and becomes claimable after this delay.
C3_BATCH_RETRY_DELAY_SECONDS=5
# Set to 0 only in isolated tests. The API otherwise recovers persisted Brain
# work without waiting for a Windows Worker to poll the batch.
C3_BATCH_RECOVERY_POLL_SECONDS=10
# A claimed reply with no sent-ack is never auto-sent again. After this window
# the backend releases the Worker and creates a human handoff.
C3_SEND_ACK_STALE_AFTER_SECONDS=300
C3_OMNIAUTO_ROOT=/app/omniauto-rpa

# One Chejin-owned Feishu custom app. Secrets stay in the server runtime only.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BASE_URL=https://open.feishu.cn
FEISHU_HTTP_TIMEOUT_SECONDS=10

# OmniAuto knowledge/RAG architecture. Business content is intentionally empty
# until Chejin operators provide the formal product and policy knowledge.
WECHAT_KNOWLEDGE_TENANT=chejin
WECHAT_STORAGE_BACKEND=postgres
WECHAT_POSTGRES_DSN=postgresql://chejin:chejin_password@db:5432/chejin_leads
WECHAT_POSTGRES_SCHEMA=wechat_ai_customer_service
WECHAT_POSTGRES_MIRROR_FILES=false
OMNIAUTO_KNOWLEDGE_TENANT=chejin
OMNIAUTO_KNOWLEDGE_SCHEMA=wechat_ai_customer_service
VEHICLE_IMAGE_STORAGE_ROOT=/app/data/vehicle-images
VEHICLE_IMAGE_MAX_BYTES=10485760
VEHICLE_IMAGE_UPLOAD_MAX_FILES=20
VEHICLE_IMAGE_UPLOAD_MAX_TOTAL_BYTES=31457280
VEHICLE_IMAGE_MAX_COUNT=50
VEHICLE_IMAGE_MAX_PIXELS=40000000
VEHICLE_EXCEL_MAX_BYTES=8388608
VEHICLE_EXCEL_MAX_ROWS=2000
VEHICLE_IMPORT_PREVIEW_TTL_SECONDS=86400

C3_RECALL_AFTER_HOURS=72
C3_RECALL_MAX_CYCLES=3
C3_RECALL_DAILY_LIMIT=1
C3_RECALL_QUIET_START_HOUR=21
C3_RECALL_QUIET_END_HOUR=9
# Waiting friend requests may enter read-targets only after a recent first-screen
# scan actually saw the short-code session. The Worker scans every 30 seconds.
C2_FRIEND_ACCEPTANCE_VISIBLE_TTL_SECONDS=90

# 0.9.10 side-channel timing only. Disabling it must not change C0-C4 behavior.
OBSERVABILITY_ENABLED=true

# Comma-separated origins. `null` allows local file:// frontend during development.
# Production example: CORS_ORIGINS=https://ops.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,null
