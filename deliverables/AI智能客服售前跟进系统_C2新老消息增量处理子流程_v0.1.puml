@startuml
' 文档版本：v0.1.3；最后更新：2026-08-10
title AI智能客服售前跟进系统 C2 新老消息增量处理子流程（文字/语音/图片）

skinparam monochrome true
skinparam shadowing false
skinparam activity {
  BorderColor #222222
  BackgroundColor #FFFFFF
  DiamondBorderColor #222222
  DiamondBackgroundColor #FFFFFF
  ArrowColor #222222
  StartColor #222222
  EndColor #222222
}

start

partition "0. 新UI动作前先恢复历史事务" {
  :按顺序恢复sent_ack Outbox、messages Outbox、\nvoice/image ActionJournal和media Ledger;
  if (存在未结算事务?) then (是)
    if (仅纯ActionJournal意图、全部not_attempted，\n且无terminal/Ledger/Outbox?) then (是)
      :本地清理未触发动作意图;
    else (否)
      :后端返回resume_current_target /\nsettle_without_ui / retry_later;
      if (resume_current_target?) then (是)
        :只恢复原会话，重放原始完整V3消息;
        :按active_read角色和最终顺序处理状态;
      elseif (settle_without_ui?) then (是)
        :不打开微信，重放原始完整V3消息\n以fact_settlement结算;
        :禁止messages=[]代替失败事实;
        :后端固定不推进状态机、不启动Brain/交接;
        :逐source_message_key确认后才清理本地记录;
      else (retry_later或未知)
        :保留原记录并阻断所有新UI动作;
        stop
      endif
    endif
  endif
}

:历史事务结算后，检查正式包内置Vision客户端专用Key、\nProvider/HTTPS接口/模型白名单;
if (API Key/模型/地址完整?) then (是)
  :允许进入C2;
else (否)
  :vision_not_ready;
  :不扫描、不打开会话、不操作微信;
  stop
endif

:Worker已持有当前单会话UI锁;
:短码、private、read-target、authorization_revision已确认;

partition "A. initial_read：只处理新的未转写语音" {
  :首次截图并生成未转写语音anchor候选\n保存为current_valid_frame;
  :按物理气泡归并候选\n一个canonical_voice_id对应多个anchor aliases;
  :冻结canonical_voice_id集合\n禁止structural/stable各自成为待处理对象;

  while (还有未转写语音候选?) is (是)
    :取下一条canonical_voice_id\naliases仅用于重新定位;
    :生成唯一voice_source_key;
    :查询Worker SQLite已处理清单;

    if (已存在terminal记录?) then (completed)
      :旧语音已完成;
      :不右键、不重复转写;
    elseif (已存在terminal记录?) then (failed)
      :旧语音已明确失败;
      :不自动重试、不保留pending;
    elseif (属于Outbox未确认批次?) then (是)
      :复用Outbox中的转写结果;
      :不重复操作微信;
    else (全新语音)
      :持久化唯一ActionJournal item和replayable_observation\naction_phase=not_attempted;
      :Journal必须恰好匹配一个canonical_voice_id\n零匹配或多匹配均零点击;
      :Worker编排OmniAuto RPA;
      :重新定位anchor并右键;
      :右键/点击前先落盘\naction_phase=trigger_attempted\n落盘失败则禁止点击;
      :点击转文字入口;
      :页面变化后废弃旧坐标并重新截图;
      :将完整截图和OCR结果更新为current_valid_frame;
      :OCR读取转写正文;

      if (正文与父语音绑定成功?) then (是)
        :action_phase=confirmed;
        :merge_item_outcomes加入voice completed\n正文 + parent anchor + sender_role;
      elseif (有证据证明动作未触发?) then (是)
        :action_phase=not_attempted;
        :merge_item_outcomes加入voice failed + error_code;
      else (已触发但结果不确定)
        :action_phase=trigger_attempted;
        :merge_item_outcomes加入voice failed\nVOICE_TRANSCRIBE_RESULT_UNKNOWN;
      endif
      :若当前项失败，关闭残留菜单并恢复稳定画面\n继续下一条canonical_voice_id;
    endif
  endwhile (否)

  :completed集合和failed集合只增不减;
  :不得用最后一次调用结果覆盖本轮累计集合;
  :任何身份/合同/授权错误返回前\nfinally将冻结集合全部结算为completed/failed;
  :断言completed+failed=冻结数且not_attempted=0;

  if (消息状态顺序为OLD*后接NEW*?) then (正常)
    :history_gap=false;
  else (NEW下面再次出现OLD)
    :本地Ledger与后端recent_messages共同重建NEW/OLD;
    if (后端可证明连续或缺口位于reply_safe_boundary之前?) then (是)
      :history_gap=false\n旧区间仅backfill/warning;
    else (否)
      :标记C2_MESSAGE_HISTORY_GAP\n建立L2 recoverable_hold;
      :纯数据恢复后最多稳定重读一次;
    endif
    note right
      第一次异常不创建长期handoff。
      两次或120秒后仍切入最新待回复尾部，
      才只对当前会话handoff。
    end note
  endif
}

partition "B. final_read：复用最后有效画面" {
  if (本轮执行过语音且最后画面完整稳定?) then (是)
    :复用最后一条语音确认后的current_valid_frame;
  elseif (本轮没有执行语音?) then (是)
    :复用initial_read的current_valid_frame;
  else (最后画面无效)
    :关闭残留菜单并等待稳定;
    :仅在此异常分支补截一张完整新图;
    :更新current_valid_frame;
  endif
  :current_valid_frame成为final_read唯一权威画面;
  :再次确认顶部短码和private;
  :先识别文字行、语音条、语音转写行及父子关系;
  :同一父语音合并为explained_voice_region;
  :在结构图片候选生成前排除被可靠文字/语音结构解释的高重叠区域;
  :仅对未解释表面生成structural_image_candidate;
  :任一可靠文字/语音类型证据均否决冲突图片候选;
  note right
    action_phase / effective_success / click.ok /
    后端确认 / 全部alias只决定结算，不决定消息是不是语音。
    禁止用弱图片候选先删除已解析文字/语音。
    也禁止简化为“有文字就不是图片”。
  end note
  if (图片检测/物理锚点异常或候选被截断?) then (是)
    :C2_IMAGE_OBSERVATION_FAILED;
    :不得伪装成0张图片\n入库和Brain前失败关闭;
    stop
  else (正常，含0张)
  endif
  :所有模态调用C2统一sender_role边界;
  :按final_read visual_top建立全部slots和screen_order;
  note right
    被语音展开挤出最终屏幕的消息本轮不处理。
    不主动上滚，不用initial_read坐标补位。
  end note
}

partition "C. 为每个最终slot生成稳定身份" {
  :遍历final_read全部slots;

  while (还有slot?) is (是)
    :读取row_kind / sender_role / bubble evidence;

    if (sender_role可信?) then (是)
      if (row_kind=text) then (文字)
        :source key = 稳定输入ID优先;
        :降级 = 角色 + 归一化正文 + 同类出现序号;
      elseif (row_kind=voice) then (语音)
        :source key = 父voice稳定anchor优先;
        :降级 = 角色 + 正文 + 时长 + 同类出现序号;
      elseif (row_kind=image) then (图片)
        :source key = canonical_visual_id优先;
        :降级 = 角色 + 同类出现序号 + 邻近稳定消息锚点;
        note right
          image_hash在复制图片后才能获得，
          只能加强证据，不能作为复制前唯一去重条件。
        end note
      else (其他)
        :按system/file等受控合同处理;
      endif
    else (否)
      :slot标记identity_or_role_unconfirmed;
      if (row_kind=image?) then (是)
        :尚未建立业务图片身份;
        :MESSAGE_IDENTITY_UNCONFIRMED帧级门禁;
        :零点击/零Vision/零terminal ledger;
      else (否)
        :普通消息不入库;
      endif
      :不自动增强、不触发Brain;
    endif
  endwhile (否)

  note right
    screen_order、visual_top、绝对坐标、扫描时间、
    authorization_revision均不得参与消息身份。
    同一客户连续发送两条相同文字或相同图片，
    由稳定来源ID/同类出现序号/邻近锚点区分为两条消息。
  end note
}

partition "D. 查询本地已处理清单，判定新老消息" {
  :按conversation_id + source_message_key\n批量查询Worker SQLite;

  while (还有slot判定结果?) is (是)
    :取一个slot及其ledger状态;

    if (ledger=INGESTED_COMPLETED?) then (是)
      :OLD_COMPLETED;
      if (文字?) then (是)
        :不重复上报文字;
      elseif (语音?) then (是)
        :不重复右键和转写;
      elseif (图片?) then (是)
        :不重复复制或调用Vision;
      endif
      :仅保留为当前画面的顺序和证据;

    elseif (ledger=INGESTED_FAILED?) then (是)
      :OLD_FAILED;
      :失败已经是终态;
      :不自动重试语音或Vision;
      :未被后续销售事实覆盖的customer/self失败\n继续保持上下文门禁;

    elseif (ledger=OUTBOX_WAITING?) then (是)
      :OLD_WAITING_INGEST;
      :内容处理已经完成，只是服务端未确认;
      :沿用原read_run_id和完整JSON重传;
      :不重复执行OCR后续动作/语音RPA/Vision;

    elseif (ledger=CAPABILITY_PAUSED?) then (是)
      :OLD_CAPABILITY_PAUSED;
      :冻结原Outbox，不重复昂贵动作;
      :按退避周期自动探测合同/能力恢复;

    elseif (ledger不存在?) then (是)
      :NEW_MESSAGE;

      if (新文字?) then (是)
        :保存OCR正文、角色和稳定身份;
        :item_state=completed;
      elseif (新语音且本flow转写成功?) then (是)
        :将转写正文回填final slot;
        :message_type=voice;
        :item_state=completed;
      elseif (新语音但转写失败?) then (是)
        :保存voice failed事实和error_code;
        :不得伪装成text;
      elseif (新图片?) then (是)
        :进入图片增强队列;
      else (证据不足)
        :帧级身份门禁;
      endif

    else (身份冲突)
      :MESSAGE_IDENTITY_UNCONFIRMED;
      :不得只凭content或image hash猜成旧消息;
      :不自动增强、不触发Brain;
    endif
  endwhile (否)
}

partition "E. 只对NEW_IMAGE执行一次Vision" {
  note
    复用以OmniAuto 855c218为基础、从2318bd8选择性接入的图片一致性能力，
    不新增第二套剪贴板模块，不使用claim_copy_ownership/微信PID硬门禁。
    稳定slot和C2角色决定图片身份；现有指纹只作复制一致性辅助检查。
  end note
  while (还有NEW_IMAGE?) is (是)
    :页面变化时重建完整final_read;
    if (图片已被顶出当前屏?) then (是)
      :从本轮候选删除;
      :不门禁、不追踪、不上滚;
    elseif (图片仍可见但身份无法唯一确认?) then (是)
      :item_state=failed;
      :error_code=C2_IMAGE_SLOT_RECONFIRM_FAILED;
      :不右键、不调用Vision、不跨轮重试;
    else (身份唯一)
      :用最新bubble_rect重新确认图片;
      :C2同行头像规则再次确认customer/self;
      if (刷新C2角色与初始角色一致?) then (是)
        :visual_side只记录诊断;
        :持久化图片动作意图\naction_phase=not_attempted;
        :右键 -> OCR识别完整菜单;
        :从同一截图唯一确定真实menu_panel_bounds;
        :所有分类项与复制点击项必须完整位于\n同一menu_panel_bounds和同一纵列;
        :大范围锚点搜索区不得当成弹窗边界\n仅去掉末尾省略号;
        note right
          文字 = 放大阅读 OR (翻译 AND 搜一搜)
          语音 = 语音转文字 OR 收起文字
          图片 = 复制 AND (编辑/用窗口打开/另存为/打开方式至少一项)
          复制/转发/收藏/多选/提醒/引用/删除不能单独证明类型
        end note
        if (精确确认为文字菜单?) then (是)
          :关闭菜单\n不点复制/不读剪贴板/不调用Vision;
          :item_state=failed\nerror_code=C2_IMAGE_SOURCE_INVALID\nreason_detail=text_context_menu_rejected\naction_phase=not_attempted;
          :原始完整V3消息立即写入ledger/Outbox;
        elseif (精确确认为语音菜单?) then (是)
          :关闭菜单\n不点复制/不读剪贴板/不调用Vision;
          :item_state=failed\nerror_code=C2_IMAGE_SOURCE_INVALID\nreason_detail=voice_context_menu_rejected\naction_phase=not_attempted;
          :原始完整V3消息立即写入ledger/Outbox;
        elseif (精确确认为图片菜单?) then (是)
          :复制物理点击前先落盘\naction_phase=trigger_attempted\n落盘失败则禁止点击;
          :点击复制并有界检查剪贴板;
          if (稳定确认不是可解码位图?) then (是)
            :item_state=failed\nerror_code=C2_IMAGE_SOURCE_INVALID\nreason_detail=clipboard_current_content_not_bitmap\naction_phase=trigger_attempted;
            :立即写入ledger/Outbox\n不重复UI/Vision;
          else (否)
            :剪贴板位图读入内存;
            :按像素/源内存上限解码;
            :缩放并自适应编码到Provider上限;
            :校验image_hash/目标视觉指纹;
            :清除本次Windows剪贴板内容;
            :Worker进程内调用OmniAuto BuiltinVisionPlugin\n不上传车金后端、不保存本地图片;
            :使用CI注入的正式包内置客户端专用Key\nHTTPS + 白名单request_style调用真实Vision;
            :父进程预算覆盖合法的两次模型请求;
            :等待单张图片Vision明确终态;

            if (Vision成功且共享JSON Schema合法?) then (是)
              :action_phase=confirmed;
              :回填vision_summary/OCR/entities/intent_hints;
              :merge_item_outcomes加入item_state=completed;
            elseif (有证据证明复制/模型明确失败?) then (是)
              :回填status=failed + error_code;
              :merge_item_outcomes加入item_state=failed;
              :禁止终态pending;
            else (复制已触发但结果不确定)
              :回填IMAGE_PROCESS_RESULT_UNKNOWN;
              :merge_item_outcomes加入item_state=failed;
              :本轮不自动重复复制/Vision;
            endif

            :释放该图片内存;
          endif
        else (弹窗边界不明/只有公共项/证据不足/多类冲突)
          :关闭菜单\n不点击任何菜单项;
          :item_state=failed\nerror_code=C2_IMAGE_MENU_OPERATION_FAILED\nreason_detail=menu_panel_unconfirmed /\nmenu_evidence_incomplete / menu_evidence_conflict /\nmenu_copy_item_unsafe\naction_phase=not_attempted;
          :原始完整V3消息立即写入ledger/Outbox;
        endif
      else (否或unknown)
        :item_state=failed;
        :error_code=C2_IMAGE_SLOT_RECONFIRM_FAILED;
        :action_phase=not_attempted\n不右键、不调用Vision;
      endif
    endif
  endwhile (否)
  :结果收口器对completed/failed原子写terminal payload;
  :唯一可重入投递器幂等推进Ledger/Outbox;
  note right
    action_phase=not_attempted也不得跳过。
    任一边界崩溃从最后已落盘状态续传。
    恢复端和测试不得补造生产端缺失终态。
  end note
  :active_read逐source key确认后按影响范围处理：\n客户失败媒体->L1回答完整文字或请求重发；\n销售失败媒体->warning；\nunknown->L2身份恢复、不伪造图片消息；\n仅无法安全澄清且影响最新尾部才handoff;
  :fact_settlement逐source key确认，\n固定不改状态、不建Brain/交接;
  :completed集合和failed集合只增不减;
  :禁止会话内图片pending/deferred;
  :目标A失败完成逐source key确认和本地结算后\n释放全局门禁并继续目标B;
}

partition "F. 构建并上报增量批次" {
  :OLD_COMPLETED/OLD_FAILED不进入新请求;
  :OUTBOX_WAITING走原批次重传;
  :只收集本轮NEW_MESSAGE结果;

  if (存在NEW_MESSAGE?) then (是)
    :按final_read screen_order排序新消息;
    :一次POST messages/ingest;

    if (后端返回ingested?) then (是)
      :写入本地INGESTED_COMPLETED或INGESTED_FAILED;
      :failed语音/图片已作为事实入库\n不建立后台人工修复任务;
    elseif (后端返回duplicated?) then (是)
      :不创建数据库新记录;
      :仍回写本地已处理清单，避免下轮昂贵重复;
    elseif (recovery_action=retry?) then (是)
      :完整JSON写入本地Outbox;
      :下轮原样重传，不重复RPA/Vision;
      :设置Worker级Outbox门禁;
      :后端确认前不调用Brain、不发送回复\n不扫描或切换任何会话;
    elseif (recovery_action=refresh_and_rebuild?) then (是)
      :重新取得当前授权;
      :只重建授权/续行外壳;
      :原身份、内容、观察时间和证据不变;
      :设置Worker级Outbox门禁;
      :不重复RPA/Vision，不调用Brain\n后端确认前不扫描或切换任何会话;
    else (capability_paused或未知)
      :冻结原Outbox和ledger;
      :设置Worker级Outbox门禁;
      :按退避周期自动探测合同/能力恢复;
      :恢复前不得触发Brain\n不得扫描或切换任何会话;
    endif
  else (否)
    :不调用ingest;
    :不创建message_batch;
    :不触发Brain;
  endif
}

partition "G. Brain上下文与等待期间新增消息" {
  :后端确定reply_safe_boundary和连续reply_safe_suffix;
  if (L2门禁仍影响最新待回复尾部?) then (是)
    :recoverable_hold达到两次/120秒后才handoff;
    :释放UI锁并继续其他短码;
  elseif (本轮有ingested的新customer消息且内容完整?) then (是)
    :后端用数据库历史消息 + 本轮新增消息构建完整上下文;
    note right
      Worker不重传旧消息。
      Brain读取message_events中的旧文字、旧语音、旧图片事实；
      历史图片保留item_state/error_code、摘要/OCR/实体、
      中性查询和服务端确认product_id，
      再叠加本轮新增消息。
    end note
    :生成当前batch_id并调用回复AI引擎;
    :Worker保持当前会话和UI锁等待;

    if (回复前出现新消息?) then (是)
      :旧reply_action=superseded;
      :重新final_read全屏观察;
      :再次查询本地清单;
      :旧消息全部跳过，只处理新增delta;
      :增量入库后Brain基于完整1..N上下文重新生成;
    else (否)
      :执行send_reply/no_action/handoff终态;
    endif
  elseif (customer最新只有failed语音/图片?) then (是)
    :生成Guard批准的澄清回复\n请客户改发文字或重发媒体;
  else (否)
    :self-only或重复=no_action;
    :旧区间门禁/self媒体失败=warning\n不阻断后续完整客户尾部;
  endif
}

legend right
  |= Ledger状态 |= 含义 |= 是否重复昂贵处理 |
  | INGESTED_COMPLETED | 已成功/重复确认入库 | 否 |
  | INGESTED_FAILED | 失败事实已入库并终态收口 | 否 |
  | OUTBOX_WAITING | 处理完成但服务端尚未确认 | 否，只重传JSON |
  | NOT_FOUND | 本地从未处理过 | 是，仅本轮一次 |
  Outbox是Worker级全局门禁，不是当前会话的普通缓存。
  未确认事实存在时必须先重传/处置，不得扫描、定向读取或切换其他会话。
endlegend

stop

@enduml
